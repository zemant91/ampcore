# Copy this to .env.debug (Test Store keys, "test_..." — safe for local iteration,
# RevenueCat's SDK refuses these in Release builds) and to .env.production
# (real "appl_..." / "goog_..." store keys — used for Release/Archive/TestFlight/App Store).
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
