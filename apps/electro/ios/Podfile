# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# RevenueCat's SDK deliberately crashes (assertionFailure) if configured with
# a Test Store key ("test_...") in a Release build — that's the app's own
# safety net against shipping simulated purchases to real users. So Debug
# and Release must read different .env files: .env.debug (Test Store key,
# fast local iteration) vs .env.production (real appl_/goog_ store keys).
ENVFILES = {
  'Debug' => '$(PODS_ROOT)/../../.env.debug',
  'Release' => '$(PODS_ROOT)/../../.env.production',
}

target 'electro' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        # Xcode 27 rejects pod targets below its supported deployment range
        # (some pods still declare 9.0/12.4/13.0) — raise them to the app's minimum.
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
        if target.name == 'react-native-config'
          build_config.build_settings['ENVFILE'] = ENVFILES[build_config.name]
        end
      end
    end
  end
end
